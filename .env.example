# Expo Public Environment Variables
# These variables will be available in the React Native/Expo app via process.env.EXPO_PUBLIC_*

# API Configuration
EXPO_PUBLIC_API_URL=https://api.example.com/v1
EXPO_PUBLIC_TIMEOUT_MS=10000

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_DEBUG_MENU=false

# Supabase / Firebase / Authentication (Placeholders only)
# EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Third Party Services
# EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn
# EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token
